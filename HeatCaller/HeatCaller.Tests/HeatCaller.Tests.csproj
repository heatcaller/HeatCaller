<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the HeatCaller app. Run from the solution folder with
       `dotnet test`. See README.md beside this file. -->

  <PropertyGroup>
    <!-- The same target as the app: it is a Windows Forms app, and the
         tests load it. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>HeatCaller.Tests</RootNamespace>

    <!-- For the reason the app gives (HeatCaller.csproj): the small windows
         and panels the tests build are never designed in the designer. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />

    <!-- A real ZeroMQ publisher, for checking HeatCaller's own ZeroMQ
         subscriber (ZmtpSubscriber, for OpenStint) against something other
         than itself. Tests only: it never ships with the app (1 Nov 2026). -->
    <PackageReference Include="NetMQ" Version="4.0.4.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HeatCaller\HeatCaller.csproj" />

    <!-- The timing library, named as well as reached through the app
         (23 Oct 2026, timing layer P6): the tests use its internal types
         directly - TimingWatch, EasyLapFramer, FinishedRace, AppPaths -
         which HeatCaller.Timing opens to this assembly by name. -->
    <ProjectReference Include="..\HeatCaller.Timing\HeatCaller.Timing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Decoder captures from real nights, played back by the tests
         (EasyLapCaptureTests). Copied beside the test dll, where the tests
         look for them. -->
    <None Update="Captures\**\*.log" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WHY (25 Nov 2026, Asher: "fix any build warnings before velo packing"):
       the WebView2 package adds its WPF control for every .NET 5+ project,
       and that dll is built against an older WindowsBase than .NET 10 has,
       which gave MSB3277 on every build. HeatCaller is WinForms and only
       uses Microsoft.Web.WebView2.WinForms, so the WPF one is left out (it
       also stops shipping in the publish folder). -->
  <Target Name="LeaveOutWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
