<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10, the long-term release (supported to November 2028).
         .NET 8 stops getting security fixes on 10 November 2026, and the
         installer ships the runtime inside it, so the first build a club
         gets carries a supported one. .NET 9 was no use: it ended the same
         day as 8. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HeatCaller</AssemblyName>
    <RootNamespace>HeatCaller</RootNamespace>

    <!-- The one version number. AppVersion.Number reads it back out of the
         assembly at runtime, and the installer (Velopack) reads the same
         assembly, so the package, the updater and the title bar cannot
         drift apart. Bump it here and nowhere else. -->
    <Version>0.60.0</Version>

    <!-- The name Windows shows for the exe (Task Manager, file properties). -->
    <Product>HeatCaller</Product>
    <AssemblyTitle>HeatCaller</AssemblyTitle>
    <!-- The Sunset Grid (24 Oct 2026): the exe's own icon, which Explorer
         and the desktop and Start menu shortcuts show. The same file is
         embedded below for the windows and the tray icon (AppIcon). -->
    <ApplicationIcon>Assets\HeatCaller.ico</ApplicationIcon>

    <!-- Every page here is laid out at fixed pixel coordinates. Under the
         SDK default (SystemAware) those are scaled by the OS on a
         high-DPI display, which blurs text and can clip controls whose
         positions were measured at 100%. DpiUnaware keeps the layout
         exactly as designed on every machine - slightly soft on a 4K
         screen, but predictable rather than subtly broken. -->
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>

    <!-- WFO1000 (from .NET 9, an error): every public property of a
         control must say how the Windows Forms designer is to save it into
         a form's .Designer.cs, so the designer cannot write out something
         private by accident. HeatCaller's own controls are not designed in
         Visual Studio's designer - every page and window is put together in
         code (LayoutPieces) - so there is nothing for the designer to save,
         and the 60-odd properties it would flag (Result on every dialog, a
         canvas's settings) would each carry an attribute that means
         nothing. Off, for that reason; if a control is ever laid out in the
         designer, give its properties [DesignerSerializationVisibility] and
         turn this back on. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- SocketIOClient was here for Next Level Timing's Neon Timing API.
         That connection was retired in 0.50.0, and nothing else used it. -->

    <!-- MP3 playback for ElevenLabs text-to-speech announcements. -->
    <PackageReference Include="NAudio" Version="2.3.0" />

    <!-- USB HID communication for the direct EasyLap decoder connection
         (talks to the Silicon Labs CP2110 chip inside it), bypassing
         Next Level Timing entirely. -->
    <PackageReference Include="HidSharp" Version="2.1.0" />

    <!-- Serial port access for the I-Lap decoder connection. Modern .NET
         does not ship System.IO.Ports in the box. Kept at the runtime's own
         version, 10.0.x, like System.Speech below. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />

    <!-- QR code generation for printable driver check-in badges. Only the
         PngByteQRCode renderer is used, which emits PNG bytes directly
         and avoids QRCoder's optional System.Drawing-dependent renderers. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />

    <!-- Windows DPAPI (ProtectedData), so API keys, the relay token and
         PINs are sealed to this Windows account on disk instead of sitting
         in settings.json as plain text. See SecretBox. No package: from
         .NET 10 it comes with the Windows desktop runtime, and the build
         said so (NU1510, 1 Oct) - it was a package on .NET 8. -->

    <!-- The free Windows voice (SAPI 5). Retired on 10 Oct 2026 - Kokoro
         speaks in its place - and no code uses this package any more; it
         is still referenced, so it still ships and is still on the About
         box's list. -->
    <PackageReference Include="System.Speech" Version="10.0.12" />

    <!-- The Kokoro voice (KokoroSpeech): a free, natural-sounding voice that
         runs on this PC's CPU through ONNX Runtime. The .CPU package is the
         plug-and-play one - it brings ONNX Runtime's native files with it.
         Its voices (small .npy files) are copied next to the exe on build,
         under voices\. The 310 MB model ships too, beside the exe, from
         the PublishKokoroModel target below; Voice Settings can download it
         again if that copy will not load. -->
    <PackageReference Include="KokoroSharp.CPU" Version="0.8.4" />
    <PackageReference Include="Velopack" Version="1.2.161" />

    <!-- The commentary model that runs when the club has no internet
         (BundledLlmClient). LLamaSharp is the managed binding; the Cpu
         backend carries llama.cpp's native libraries, one set per
         instruction set (avx, avx2, avx512), and picks the right one for
         the PC at runtime - which is how one installer serves a new i7 and
         an old club desktop without shipping two builds.

         BOTH VERSIONS ARE PINNED, and must move together. LLamaSharp's own
         README warns that llama.cpp break changes invalidate model weights
         between releases, so a floating version here is a release that
         silently stops loading commentary.gguf. 0.27.0 is the release whose
         verified-model list covers the Qwen3 family fetch-llm.cmd pulls.

         The CPU backend only. The Cuda and Vulkan backends are hundreds of
         megabytes and a 0.6B model does not need a GPU - see fetch-llm.cmd
         for why the model is this small. -->
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />

    <!-- Sponsor VIDEO slides on the Big Screen (see SponsorVideo.cs). The
         managed wrapper, its WinForms VideoView, and VLC's own native
         libraries - all three from VideoLAN, all LGPL-2.1-or-later, which
         is why the About box lists them and Assets\Licences carries the
         licence text.

         Windows Media Foundation would have been smaller, but it plays
         only what the PC has codecs for, and a club's sponsor hands over
         whatever their agency exported. LibVLC carries its own decoders,
         so a video that plays on the operator's laptop plays on the track
         PC. The size that buys is dealt with directly below. -->
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />

    <!-- The installer and the updater (Velopack, MIT). VelopackApp.Build().Run()
         is the first thing Main does, and AppUpdates is the rest of it.
         ADD IT WITH: dotnet add package Velopack
         - run from this folder, so NuGet writes the current stable version in
         here itself rather than this file carrying one typed from memory.
         Until it is added, Program.cs and AppUpdates.cs do not compile. -->
  </ItemGroup>

  <ItemGroup>
    <!-- The timing layer: the race engine, the timing thread and clock, the
         race journal and the decoder framing (23 Oct 2026, timing layer
         P6). A plain net10.0 library with no WinForms and no packages, so
         nothing on a screen can creep into it. Same namespace (HeatCaller),
         so no file here needs a using for it. Built automatically with the
         app, and its dll ships beside HeatCaller.exe. -->
    <ProjectReference Include="..\HeatCaller.Timing\HeatCaller.Timing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project (..\HeatCaller.Tests) reaches the app's internal
         types - AppPaths.RedirectForTests above all, which keeps every test
         away from the real %AppData%\HeatCaller. -->
    <InternalsVisibleTo Include="HeatCaller.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bundled soundtrack. Copied next to the executable on build and
         then installed into %AppData%\HeatCaller\Music on first run
         (see MusicStore) - the app plays from there, so a user's own
         uploads and the built-in tracks live in one place. -->
    <!-- Link preserves the folder structure. Without it MSBuild flattens
         these next to the exe, and MusicStore.InstallBundledTracks - which
         looks in <output>\Assets\Music - finds nothing and silently
         installs no tracks at all. -->
    <None Include="Assets\Music\*.wav" Link="Assets\Music\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <!-- MP3 is still copied if present: the bundled soundtrack is WAV for
         quality, but nothing stops a track being dropped in as MP3, and the
         player accepts both. -->
    <None Include="Assets\Music\*.mp3" Link="Assets\Music\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <!-- The app's own typefaces, loaded at startup by FontLibrary rather
         than installed on the machine, so a track PC nobody can install
         software on still renders HeatCaller properly. Same Link trick as
         the music above: without it MSBuild flattens these next to the exe
         and FontLibrary - which looks in <output>\Assets\Fonts - finds an
         empty folder and silently falls back to Segoe UI.

         Only the Regular and Bold cuts of each family are wanted. GDI knows
         four styles, so a file like Oxanium-SemiBold.ttf registers as its
         OWN family ("Oxanium SemiBold") and would never be found by asking
         for Oxanium with FontStyle.Bold. Variable-weight files
         (Oxanium[wght].ttf) have the same problem - use the static cuts. -->
    <!-- The built-in sound packs - Assets\SoundPacks\<Pack>\<Effect>.wav.
         Played straight from beside the exe (see SoundPacks). Same Link
         trick as the music, with %(RecursiveDir) so each pack keeps its
         own folder instead of all eleven GoodLap.wav files landing on top
         of each other. -->
    <None Include="Assets\SoundPacks\**\*.wav" Link="Assets\SoundPacks\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <!-- The show music that ships with the app - Assets\ShowMusic\Beds\*
         and Assets\ShowMusic\Openers\*. Played straight from beside the
         exe, exactly as the sound packs above are and for the same reason
         (see ShowMusicLibrary): nobody edits them, and an update replacing
         them is what should happen. A club's OWN file still wins, and that
         one is copied into %AppData%\HeatCaller\ShowMusic by
         ShowMusic.Install.
         The Link= is load-bearing here too. Without it MSBuild flattens
         Beds\ and Openers\ into one folder beside the exe, and
         ShowMusicLibrary.For - which lists <output>\Assets\ShowMusic\Beds
         and ...\Openers - finds nothing and silently offers no music at
         all. The same trap the music and the sound packs each carry a
         comment about. -->
    <None Include="Assets\ShowMusic\**\*.mp3" Link="Assets\ShowMusic\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\ShowMusic\**\*.wav" Link="Assets\ShowMusic\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <!-- Each soundscape's broadcast imaging - Assets\Imaging\<Soundscape>\
         "<Soundscape> <Element> <N>.mp3", read by BroadcastImaging. Link=
         keeps the soundscape folders, for the reason the show music's
         comment above gives: flattened, every soundscape would find
         nothing of its own. -->
    <None Include="Assets\Imaging\**\*.mp3" Link="Assets\Imaging\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Imaging\**\*.wav" Link="Assets\Imaging\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Where each shipped piece's post is (BroadcastImaging.ShippedPost). -->
    <None Include="Assets\Imaging\**\posts.json" Link="Assets\Imaging\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <!-- Licence texts that have to travel with the app because the package
         they belong to does not carry one: MisakiSharp's NOTICE (Apache-2.0
         4(d) asks for it) and OpenTK's MIT notice. Kokoro's own LICENSE is
         not here - KokoroSharp already lands it in voices\. See
         ThirdPartyCatalog in About.cs, which is the list the About box
         shows and the thing to keep in step with this folder. -->
    <None Include="Assets\Licences\*.txt" Link="Assets\Licences\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <!-- The app's icon, for every window and the tray icon - see AppIcon. -->
    <EmbeddedResource Include="Assets\HeatCaller.ico" LogicalName="HeatCaller.AppIcon.ico" />
    <None Include="Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\*.otf" Link="Assets\Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Globbed, not named. A literal Include of a file that is not there
         yet fails the copy task outright (MSB3030); a glob that matches
         nothing is simply empty, so the project still builds on a clone
         with no fonts dropped in. This carries the OFL licence files, which
         have to travel with the fonts when the app is redistributed. -->
    <None Include="Assets\Fonts\*.txt" Link="Assets\Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- VideoLAN.LibVLC.Windows ships THREE complete copies of VLC - x64,
       x86 and arm64 - at about 108 MB each, and picks which to copy from
       $(Platform). A .NET SDK project's Platform is AnyCPU, which its
       targets read as "all of them": 315 MB into every build output and
       every publish, of which the app can load one.

       The two the app can never load are switched off here. HeatCaller
       publishes -r win-x64 (publish.cmd), so win-x64 is the only copy that
       could ever be loaded - an ARM64 Windows PC runs the x64 build, and
       this x64 VLC with it, under the same emulation. The property names
       are the package's own (VideoLAN.LibVLC.Windows.targets); it offers no
       way to say "just the one for my RID", which is why this is three
       properties rather than one.

       The target folder is left at the package's default, libvlc\win-x64,
       because SponsorVideoEngine.NativeFolderName is the other half of that
       agreement and PublishLayoutTests holds the two together. -->
  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <!-- What of the remaining x64 copy actually ships.

       Declared rather than left to the package, whose default is
       "libvlc.*;libvlccore.*;hrtfs\**;lua\**;plugins\**". That default
       carries libvlc.lib and libvlccore.lib - import libraries for a C++
       linker, never loaded at runtime by anything, exactly like the two
       .lib files the ONNX target below drops - and 103 MB of plugins, for a
       player that does one thing: play a local video file on a screen.

       The %2A escaping is the package's: these items are run through
       MSBuild::Unescape inside its targets, so a literal * here would be
       globbed against this folder and match nothing.

       Kept deliberately broad within plugins\: every DECODER and every
       DEMUXER stays, because the whole reason for choosing LibVLC over
       Media Foundation was that a club's sponsor sends whatever their
       agency exported. What goes is whole categories this app has no path
       to - sending a stream out, discovering servers, writing files,
       drawing music visualisations, reading metadata - and nothing that
       could be asked to open an ad. Roughly 75 MB of plugins remain. If a
       club ever reports a video that plays in VLC but not in HeatCaller,
       this list is the first place to look: add the category back rather
       than guessing at a codec. -->
  <ItemGroup>
    <!-- hrtfs\ is 92 KB and is how VLC folds a 5.1 soundtrack down to the
         two speakers on a club's screen. Left out at first, and LibVLC said
         so on every ad with surround sound ("Could not load the SOFA
         HRTF") - a sponsor's agency exports 5.1 more often than it should. -->
    <VlcWindowsX64IncludeFiles Include="libvlc.dll;libvlccore.dll;hrtfs\%2A%2A;plugins\%2A%2A" />

    <!-- Muxing and sending media OUT. HeatCaller never does: the OBS
         overlay is a web page (see WebServerService), not a VLC stream. -->
    <VlcWindowsX64ExcludeFiles Include="plugins\access_output\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\stream_out\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\mux\%2A%2A" />

    <!-- Finding media on a network, and the credentials for it. A sponsor
         slide is a file in %AppData%\HeatCaller\Sponsors and nothing else -
         SponsorMedia.VideoExtensions deliberately excludes playlists so
         that stays true. -->
    <VlcWindowsX64ExcludeFiles Include="plugins\services_discovery\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\keystore\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\stream_extractor\%2A%2A" />

    <!-- VLC's own interface furniture: music visualisations, media-library
         metadata, splitting one video across several screens. -->
    <VlcWindowsX64ExcludeFiles Include="plugins\visualization\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\meta_engine\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\video_splitter\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\lua\%2A%2A" />

    <!-- The four biggest access plugins, all of them for pulling media off
         a network or an optical disc: SRT and RIST are broadcast transports,
         DCP is digital-cinema, and libbluray reads Blu-ray structures.
         11 MB between them, and no route to any of them from a file on
         disk. Named one by one, unlike the categories above, because
         plugins\access also holds the filesystem reader that opens the ad. -->
    <VlcWindowsX64ExcludeFiles Include="plugins\access\libaccess_srt_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\access\librist_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\access\libdcp_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\access\liblibbluray_plugin.dll" />

    <!-- ENCODERS, not decoders: x264 and AOM's AV1 encoder are for making
         video files, which nothing here does. dav1d, the AV1 DECODER,
         deliberately stays. -->
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libx26410b_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libaom_plugin.dll" />
  </ItemGroup>

  <!-- ONNX Runtime (pulled in by KokoroSharp.CPU) ships its native library
       for every platform it supports: Android (onnxruntime.aar), iOS
       (onnxruntime.xcframework.zip), macOS (.dylib), Linux (.so) and three
       Windows architectures. A build with no runtime identifier - the plain
       `dotnet build`, and anything packed from its output - takes the whole
       set: 211 MB of natives, of which a Windows PC can load 36 MB and a
       Windows x64 PC 12 MB. It also carries onnxruntime.lib and
       onnxruntime_providers_shared.lib, which are import libraries for a
       C++ linker and are never loaded at runtime by anything.

       Dropped here, before the copy step reads the list. Scoped to the one
       package and to those file kinds, so the Windows DLLs that do the work
       are untouched and no other package is affected - the targeted removal
       rather than a rule about runtimes\ in general. The self-contained
       win-x64 publish would pick only win-x64 by itself, but the Debug
       output a developer runs from, and any publish cut without a runtime
       identifier, would not: this makes both honest. -->
  <Target Name="DropOnnxNativesNoWindowsPcCanLoad" AfterTargets="ResolvePackageAssets" BeforeTargets="ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntime'&#xA;                                               and ('%(RuntimeTargetsCopyLocalItems.Extension)' == '.aar'&#xA;                                                 or '%(RuntimeTargetsCopyLocalItems.Extension)' == '.zip'&#xA;                                                 or '%(RuntimeTargetsCopyLocalItems.Extension)' == '.dylib'&#xA;                                                 or '%(RuntimeTargetsCopyLocalItems.Extension)' == '.so'&#xA;                                                 or '%(RuntimeTargetsCopyLocalItems.Extension)' == '.lib')" />
      <!-- The same list again for a runtime-identifier build, where the
           chosen platform's natives arrive as NativeCopyLocalItems and land
           flat beside the exe instead of under runtimes\. That is the shape
           the installer is cut from, and it is where the two .lib files
           would otherwise turn up next to HeatCaller.exe. -->
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntime'&#xA;                                       and ('%(NativeCopyLocalItems.Extension)' == '.aar'&#xA;                                         or '%(NativeCopyLocalItems.Extension)' == '.zip'&#xA;                                         or '%(NativeCopyLocalItems.Extension)' == '.dylib'&#xA;                                         or '%(NativeCopyLocalItems.Extension)' == '.so'&#xA;                                         or '%(NativeCopyLocalItems.Extension)' == '.lib')" />
    </ItemGroup>
  </Target>

  <!-- Kokoro's voice files (voices\*.npy, and Kokoro's own licence with
       them) are copied beside the exe by KokoroSharp's own targets, whose
       CopyContent target runs AfterTargets="Build" and copies straight into
       $(OutputPath) with a Copy task. Nothing about that reaches publish:
       the files are not items the publish step knows, so `dotnet publish`
       produced a folder with no voices\ at all, and KokoroSpeech - which
       looks in AppContext.BaseDirectory\voices - would have told the first
       club to install the real installer "Kokoro's voices folder is missing
       from beside HeatCaller.exe - reinstall HeatCaller."

       So they are handed to publish here, taken from the build output they
       were already copied into rather than from a hard-coded package path
       that would need editing on every KokoroSharp bump. RecursiveDir keeps
       voices-zh\ where it belongs; KokoroSpeech searches subfolders. -->
  <Target Name="PublishKokoroVoiceFiles" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <!-- The English voices only. KokoroSharp ships 157 .npy files; the
           picker shows the 31 that pass KokoroSpeech.IsEnglishVoice - an
           American or British, female or male name, so af_, am_, bf_, bm_ -
           and the other 126 were being copied into the installer where
           nothing could ever choose them. 66 MB, which is a fifth of the
           model this same publish now carries. The prefixes are spelled out
           because MSBuild globs cannot express the one-line rule the C# does;
           if IsEnglishVoice ever widens, widen this with it (PublishLayoutTests
           holds the two together). -->
      <_KokoroVoiceFile Include="$(OutputPath)voices\**\af_*.npy;$(OutputPath)voices\**\am_*.npy;$(OutputPath)voices\**\bf_*.npy;$(OutputPath)voices\**\bm_*.npy" />

      <!-- Everything in voices\ that is not a voice: Kokoro's own
           Apache-2.0 LICENSE above all, which has to travel with the model
           and its voices. Separate from the filter above so narrowing the
           voices can never drop the licence with them. -->
      <_KokoroVoiceExtra Include="$(OutputPath)voices\**\*" Exclude="$(OutputPath)voices\**\*.npy" />

      <ResolvedFileToPublish Include="@(_KokoroVoiceFile);@(_KokoroVoiceExtra)">
        <RelativePath>voices\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <!-- An ERROR since 10 Oct 2026, when the Windows voice was retired and
         Kokoro became the only free voice AND the fallback for every other
         one. A publish with no voices beside the exe is now an installer
         that cannot say a word, and a warning in the middle of a publish
         log is not enough to stop that reaching a club. Publish-only
         target (BeforeTargets=ComputeResolvedFilesToPublishList), so an
         ordinary build and check.cmd never see it. -->
    <Error Condition="'@(_KokoroVoiceFile)' == ''" Text="No Kokoro voice files found in $(OutputPath)voices - the published app will not be able to speak in the Kokoro voice, which since 10 Oct 2026 is the only voice that always works. Build before publishing, and check KokoroSharp's CopyContent target still copies them." />
  </Target>

  <!-- The Kokoro model itself (~310 MB), shipped beside the exe so a club at
       a track with bad Wi-Fi gets a working natural voice with nothing to go
       wrong on the night. KokoroSpeech.BundledModelPath is where it looks for
       it, which is why it lands flat beside HeatCaller.exe and not in a
       subfolder.

       NOT IN GIT, and not copied into a build either - only into a publish.
       A 310 MB file has no business in the repository and no business being
       copied on every F5 when a developer already has the downloaded copy in
       %LocalAppData%\HeatCaller\Kokoro. Put it in Assets\Kokoro\ once, with
       fetch-kokoro.cmd, and it is picked up from there every publish after.

       Globbed rather than named for the usual reason: a literal Include of a
       file that is not there fails the copy outright (MSB3030), while a glob
       that matches nothing is simply empty - so the project still builds and
       publishes on a clone with no model, and the warning below says what
       that publish will be missing. -->
  <Target Name="PublishKokoroModel" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_KokoroModelFile Include="Assets\Kokoro\kokoro.onnx" Condition="Exists('Assets\Kokoro\kokoro.onnx')" />
      <ResolvedFileToPublish Include="@(_KokoroModelFile)">
        <RelativePath>kokoro.onnx</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <!-- An ERROR since 10 Oct 2026. It was a warning, and the argument for
         that was written down here: "a publish without the model is still a
         working app - KokoroSpeech falls back to the download". That was
         true while the Windows voice sat underneath everything. The Windows
         voice is gone, Kokoro is the only free voice and the fallback for
         every other one, so a publish without the model is now an installer
         that CANNOT SPEAK AT ALL until somebody downloads 310 MB over the
         club's Wi-Fi - which is exactly the night this was bundled to
         avoid. Publish-only target, so an ordinary build and check.cmd
         never see it; fetch-kokoro.cmd is the one-line fix and the message
         says so. -->
    <Error Condition="'@(_KokoroModelFile)' == ''" Text="Assets\Kokoro\kokoro.onnx is not there, so the Kokoro voice would NOT be in this publish - and since the Windows voice was retired Kokoro is the only voice that always works, so that installer could not speak at all until a club downloaded 310 MB. Run fetch-kokoro.cmd and publish again." />
  </Target>

  <!-- The commentary model (~440 MB), shipped beside the exe so a club with
       no internet still gets colour commentary. BundledLlmClient's
       BundledModelPath is where it looks for it, which is why it lands flat
       beside HeatCaller.exe under the app's own name for it rather than the
       model's - swapping which model ships is then a change to fetch-llm.cmd
       and nothing else.

       NOT IN GIT, and not copied into a build either - only into a publish,
       for the same reasons as the Kokoro model above.

       Globbed rather than named: a literal Include of a file that is not
       there fails the copy outright (MSB3030), while a glob that matches
       nothing is simply empty - so a clone with no model still builds and
       publishes, and the warning below says what that publish is missing. -->
  <Target Name="PublishLocalModel" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_LocalModelFile Include="Assets\LocalModel\commentary.gguf" Condition="Exists('Assets\LocalModel\commentary.gguf')" />
      <ResolvedFileToPublish Include="@(_LocalModelFile)">
        <RelativePath>commentary.gguf</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <!-- A WARNING, not an error, and the difference from PublishKokoroModel
         is deliberate. Kokoro is the only voice that always works, so a
         publish without it cannot speak at all. This model only writes when
         the relay cannot be reached, so a publish without it is a working
         installer that goes quiet on segments during an internet outage -
         worse, but not broken. Publish-only, so an ordinary build and
         check.cmd never see it. -->
    <Warning Condition="'@(_LocalModelFile)' == ''" Text="Assets\LocalModel\commentary.gguf is not there, so this publish has NO offline commentary - a club with the internet down will get no colour from the Core segments at all. Run fetch-llm.cmd and publish again." />
  </Target>

</Project>
