<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10, the long-term release (supported to November 2028).
         .NET 8 stops getting security fixes on 10 November 2026, and the
         installer ships the runtime inside it, so the first build a club
         gets carries a supported one. .NET 9 was no use: it ended the same
         day as 8. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HeatCaller</AssemblyName>
    <RootNamespace>HeatCaller</RootNamespace>

    <!-- The one version number. AppVersion.Number reads it back out of the
         assembly at runtime, and the installer (Velopack) reads the same
         assembly, so the package, the updater and the title bar cannot
         drift apart. Bump it here and nowhere else. -->
    <Version>0.59.0</Version>

    <!-- The name Windows shows for the exe (Task Manager, file properties). -->
    <Product>HeatCaller</Product>
    <AssemblyTitle>HeatCaller</AssemblyTitle>
    <ApplicationIcon></ApplicationIcon>

    <!-- Every page here is laid out at fixed pixel coordinates. Under the
         SDK default (SystemAware) those are scaled by the OS on a
         high-DPI display, which blurs text and can clip controls whose
         positions were measured at 100%. DpiUnaware keeps the layout
         exactly as designed on every machine - slightly soft on a 4K
         screen, but predictable rather than subtly broken. -->
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>

    <!-- WFO1000 (from .NET 9, an error): every public property of a
         control must say how the Windows Forms designer is to save it into
         a form's .Designer.cs, so the designer cannot write out something
         private by accident. HeatCaller's own controls are not designed in
         Visual Studio's designer - every page and window is put together in
         code (LayoutPieces) - so there is nothing for the designer to save,
         and the 60-odd properties it would flag (Result on every dialog, a
         canvas's settings) would each carry an attribute that means
         nothing. Off, for that reason; if a control is ever laid out in the
         designer, give its properties [DesignerSerializationVisibility] and
         turn this back on. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- SocketIOClient was here for Next Level Timing's Neon Timing API.
         That connection was retired in 0.50.0, and nothing else used it. -->

    <!-- MP3 playback for ElevenLabs text-to-speech announcements. -->
    <PackageReference Include="NAudio" Version="2.3.0" />

    <!-- USB HID communication for the direct EasyLap decoder connection
         (talks to the Silicon Labs CP2110 chip inside it), bypassing
         Next Level Timing entirely. -->
    <PackageReference Include="HidSharp" Version="2.1.0" />

    <!-- Serial port access for the I-Lap decoder connection. Modern .NET
         does not ship System.IO.Ports in the box. Kept at the runtime's own
         version, 10.0.x, like System.Speech below. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />

    <!-- QR code generation for printable driver check-in badges. Only the
         PngByteQRCode renderer is used, which emits PNG bytes directly
         and avoids QRCoder's optional System.Drawing-dependent renderers. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />

    <!-- Windows DPAPI (ProtectedData), so API keys, the relay token and
         PINs are sealed to this Windows account on disk instead of sitting
         in settings.json as plain text. See SecretBox. No package: from
         .NET 10 it comes with the Windows desktop runtime, and the build
         said so (NU1510, 1 Oct) - it was a package on .NET 8. -->

    <!-- The free Windows voice (SAPI 5), for clubs with no ElevenLabs
         account and as the stand-in when ElevenLabs can't speak a line.
         Windows only, like the app, and no dependencies of its own. It
         only talks to the speech voices already installed in Windows -
         nothing is downloaded and no account is needed. See WindowsVoice. -->
    <PackageReference Include="System.Speech" Version="10.0.12" />

    <!-- The Kokoro voice (KokoroSpeech): a free, natural-sounding voice that
         runs on this PC's CPU through ONNX Runtime. The .CPU package is the
         plug-and-play one - it brings ONNX Runtime's native files with it.
         Its voices (small .npy files) are copied next to the exe on build,
         under voices\; the 310 MB model is NOT shipped - it is downloaded
         once from Voice Settings, only by a club that chooses Kokoro. -->
    <PackageReference Include="KokoroSharp.CPU" Version="0.8.4" />
    <PackageReference Include="Velopack" Version="1.2.161" />

    <!-- The installer and the updater (Velopack, MIT). VelopackApp.Build().Run()
         is the first thing Main does, and AppUpdates is the rest of it.
         ADD IT WITH: dotnet add package Velopack
         - run from this folder, so NuGet writes the current stable version in
         here itself rather than this file carrying one typed from memory.
         Until it is added, Program.cs and AppUpdates.cs do not compile. -->
  </ItemGroup>

  <ItemGroup>
    <!-- The test project (..\HeatCaller.Tests) reaches the app's internal
         types - AppPaths.RedirectForTests above all, which keeps every test
         away from the real %AppData%\HeatCaller. -->
    <InternalsVisibleTo Include="HeatCaller.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bundled soundtrack. Copied next to the executable on build and
         then installed into %AppData%\HeatCaller\Music on first run
         (see MusicStore) - the app plays from there, so a user's own
         uploads and the built-in tracks live in one place. -->
    <!-- Link preserves the folder structure. Without it MSBuild flattens
         these next to the exe, and MusicStore.InstallBundledTracks - which
         looks in <output>\Assets\Music - finds nothing and silently
         installs no tracks at all. -->
    <None Include="Assets\Music\*.wav" Link="Assets\Music\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <!-- MP3 is still copied if present: the bundled soundtrack is WAV for
         quality, but nothing stops a track being dropped in as MP3, and the
         player accepts both. -->
    <None Include="Assets\Music\*.mp3" Link="Assets\Music\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <!-- The app's own typefaces, loaded at startup by FontLibrary rather
         than installed on the machine, so a track PC nobody can install
         software on still renders HeatCaller properly. Same Link trick as
         the music above: without it MSBuild flattens these next to the exe
         and FontLibrary - which looks in <output>\Assets\Fonts - finds an
         empty folder and silently falls back to Segoe UI.

         Only the Regular and Bold cuts of each family are wanted. GDI knows
         four styles, so a file like Oxanium-SemiBold.ttf registers as its
         OWN family ("Oxanium SemiBold") and would never be found by asking
         for Oxanium with FontStyle.Bold. Variable-weight files
         (Oxanium[wght].ttf) have the same problem - use the static cuts. -->
    <!-- The built-in sound packs - Assets\SoundPacks\<Pack>\<Effect>.wav.
         Played straight from beside the exe (see SoundPacks). Same Link
         trick as the music, with %(RecursiveDir) so each pack keeps its
         own folder instead of all eleven GoodLap.wav files landing on top
         of each other. -->
    <None Include="Assets\SoundPacks\**\*.wav" Link="Assets\SoundPacks\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <!-- Licence texts that have to travel with the app because the package
         they belong to does not carry one: MisakiSharp's NOTICE (Apache-2.0
         4(d) asks for it) and OpenTK's MIT notice. Kokoro's own LICENSE is
         not here - KokoroSharp already lands it in voices\. See
         ThirdPartyCatalog in About.cs, which is the list the About box
         shows and the thing to keep in step with this folder. -->
    <None Include="Assets\Licences\*.txt" Link="Assets\Licences\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <None Include="Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\*.otf" Link="Assets\Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Globbed, not named. A literal Include of a file that is not there
         yet fails the copy task outright (MSB3030); a glob that matches
         nothing is simply empty, so the project still builds on a clone
         with no fonts dropped in. This carries the OFL licence files, which
         have to travel with the fonts when the app is redistributed. -->
    <None Include="Assets\Fonts\*.txt" Link="Assets\Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ONNX Runtime (pulled in by KokoroSharp.CPU) ships its native library
       for every platform it supports: Android (onnxruntime.aar), iOS
       (onnxruntime.xcframework.zip), macOS (.dylib), Linux (.so) and three
       Windows architectures. A build with no runtime identifier - the plain
       `dotnet build`, and anything packed from its output - takes the whole
       set: 211 MB of natives, of which a Windows PC can load 36 MB and a
       Windows x64 PC 12 MB. It also carries onnxruntime.lib and
       onnxruntime_providers_shared.lib, which are import libraries for a
       C++ linker and are never loaded at runtime by anything.

       Dropped here, before the copy step reads the list. Scoped to the one
       package and to those file kinds, so the Windows DLLs that do the work
       are untouched and no other package is affected - the targeted removal
       rather than a rule about runtimes\ in general. The self-contained
       win-x64 publish would pick only win-x64 by itself, but the Debug
       output a developer runs from, and any publish cut without a runtime
       identifier, would not: this makes both honest. -->
  <Target Name="DropOnnxNativesNoWindowsPcCanLoad" AfterTargets="ResolvePackageAssets" BeforeTargets="ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntime'&#xA;                                               and ('%(RuntimeTargetsCopyLocalItems.Extension)' == '.aar'&#xA;                                                 or '%(RuntimeTargetsCopyLocalItems.Extension)' == '.zip'&#xA;                                                 or '%(RuntimeTargetsCopyLocalItems.Extension)' == '.dylib'&#xA;                                                 or '%(RuntimeTargetsCopyLocalItems.Extension)' == '.so'&#xA;                                                 or '%(RuntimeTargetsCopyLocalItems.Extension)' == '.lib')" />
      <!-- The same list again for a runtime-identifier build, where the
           chosen platform's natives arrive as NativeCopyLocalItems and land
           flat beside the exe instead of under runtimes\. That is the shape
           the installer is cut from, and it is where the two .lib files
           would otherwise turn up next to HeatCaller.exe. -->
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntime'&#xA;                                       and ('%(NativeCopyLocalItems.Extension)' == '.aar'&#xA;                                         or '%(NativeCopyLocalItems.Extension)' == '.zip'&#xA;                                         or '%(NativeCopyLocalItems.Extension)' == '.dylib'&#xA;                                         or '%(NativeCopyLocalItems.Extension)' == '.so'&#xA;                                         or '%(NativeCopyLocalItems.Extension)' == '.lib')" />
    </ItemGroup>
  </Target>

  <!-- Kokoro's voice files (voices\*.npy, and Kokoro's own licence with
       them) are copied beside the exe by KokoroSharp's own targets, whose
       CopyContent target runs AfterTargets="Build" and copies straight into
       $(OutputPath) with a Copy task. Nothing about that reaches publish:
       the files are not items the publish step knows, so `dotnet publish`
       produced a folder with no voices\ at all, and KokoroSpeech - which
       looks in AppContext.BaseDirectory\voices - would have told the first
       club to install the real installer "Kokoro's voices folder is missing
       from beside HeatCaller.exe - reinstall HeatCaller."

       So they are handed to publish here, taken from the build output they
       were already copied into rather than from a hard-coded package path
       that would need editing on every KokoroSharp bump. RecursiveDir keeps
       voices-zh\ where it belongs; KokoroSpeech searches subfolders. -->
  <Target Name="PublishKokoroVoiceFiles" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <!-- The English voices only. KokoroSharp ships 157 .npy files; the
           picker shows the 31 that pass KokoroSpeech.IsEnglishVoice - an
           American or British, female or male name, so af_, am_, bf_, bm_ -
           and the other 126 were being copied into the installer where
           nothing could ever choose them. 66 MB, which is a fifth of the
           model this same publish now carries. The prefixes are spelled out
           because MSBuild globs cannot express the one-line rule the C# does;
           if IsEnglishVoice ever widens, widen this with it (PublishLayoutTests
           holds the two together). -->
      <_KokoroVoiceFile Include="$(OutputPath)voices\**\af_*.npy;$(OutputPath)voices\**\am_*.npy;$(OutputPath)voices\**\bf_*.npy;$(OutputPath)voices\**\bm_*.npy" />

      <!-- Everything in voices\ that is not a voice: Kokoro's own
           Apache-2.0 LICENSE above all, which has to travel with the model
           and its voices. Separate from the filter above so narrowing the
           voices can never drop the licence with them. -->
      <_KokoroVoiceExtra Include="$(OutputPath)voices\**\*" Exclude="$(OutputPath)voices\**\*.npy" />

      <ResolvedFileToPublish Include="@(_KokoroVoiceFile);@(_KokoroVoiceExtra)">
        <RelativePath>voices\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <!-- Loud rather than silent: a publish with no voices beside the exe is
         a published app whose Kokoro voice cannot speak. -->
    <Warning Condition="'@(_KokoroVoiceFile)' == ''" Text="No Kokoro voice files found in $(OutputPath)voices - the published app will not be able to speak in the Kokoro voice. Build before publishing, and check KokoroSharp's CopyContent target still copies them." />
  </Target>

  <!-- The Kokoro model itself (~310 MB), shipped beside the exe so a club at
       a track with bad Wi-Fi gets a working natural voice with nothing to go
       wrong on the night. KokoroSpeech.BundledModelPath is where it looks for
       it, which is why it lands flat beside HeatCaller.exe and not in a
       subfolder.

       NOT IN GIT, and not copied into a build either - only into a publish.
       A 310 MB file has no business in the repository and no business being
       copied on every F5 when a developer already has the downloaded copy in
       %LocalAppData%\HeatCaller\Kokoro. Put it in Assets\Kokoro\ once, with
       fetch-kokoro.cmd, and it is picked up from there every publish after.

       Globbed rather than named for the usual reason: a literal Include of a
       file that is not there fails the copy outright (MSB3030), while a glob
       that matches nothing is simply empty - so the project still builds and
       publishes on a clone with no model, and the warning below says what
       that publish will be missing. -->
  <Target Name="PublishKokoroModel" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_KokoroModelFile Include="Assets\Kokoro\kokoro.onnx" Condition="Exists('Assets\Kokoro\kokoro.onnx')" />
      <ResolvedFileToPublish Include="@(_KokoroModelFile)">
        <RelativePath>kokoro.onnx</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <!-- A warning, not an error: a publish without the model is still a
         working app - KokoroSpeech falls back to the download, exactly as it
         did before this was bundled - it is just not the installer we mean to
         ship to a club. -->
    <Warning Condition="'@(_KokoroModelFile)' == ''" Text="Assets\Kokoro\kokoro.onnx is not there, so the Kokoro voice is NOT in this publish - a club installing it would have to download 310 MB from Voice Settings before the natural voice could speak. Run fetch-kokoro.cmd and publish again." />
  </Target>

</Project>
