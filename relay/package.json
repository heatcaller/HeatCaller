{
  "name": "heatcaller-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Publishes a HeatCaller club's race data to a stable https address. The laptop stays the source of truth.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "start": "node dist/src/index.js",
    "mint": "tsc && node dist/src/index.js mint"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}